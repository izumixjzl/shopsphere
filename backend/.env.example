APP_NAME=ShopSphere
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

# Only needed if the React app is hosted on a different domain (comma-separated list allowed)
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopsphere
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Real-time notifications (Laravel Reverb). Run: php artisan reverb:start
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=shopsphere
REVERB_APP_KEY=shopsphere-key
REVERB_APP_SECRET=change-me
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Email notifications. 'log' writes emails to storage/logs/laravel.log; use 'smtp' (with MAIL_HOST etc.) to really send.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@shopsphere.test"
MAIL_FROM_NAME="${APP_NAME}"
MARKETPLACE_EMAIL_NOTIFICATIONS=true

# Product images: "public" (local storage/app/public) or "s3" (any S3-compatible object storage)
FILESYSTEM_DISK=public

# Marketplace defaults
MARKETPLACE_DEFAULT_COMMISSION_RATE=10.00
MARKETPLACE_LOW_STOCK_THRESHOLD=5
MARKETPLACE_SHIPPING_FEE_PER_SELLER=50.00
MARKETPLACE_CURRENCY=PHP

# Payments: Cash on Delivery is always on. The built-in sandbox gateway (no real money) is on
# outside production. Unpaid online orders are cancelled after the timeout; needs the scheduler
# running (php artisan schedule:work) so `payments:expire` fires every minute.
PAYMENT_SANDBOX_ENABLED=true
PAYMENT_SANDBOX_WEBHOOK_SECRET=
PAYMENT_ONLINE_TIMEOUT_MINUTES=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
